{
  "name": "agentic-x",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "_description_",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/hairyf",
  "homepage": "https://github.com/hairyf/agentic-x#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/agentic-x.git"
  },
  "bugs": "https://github.com/hairyf/agentic-x/issues",
  "keywords": [],
  "exports": {
    ".": "./src/index.ts",
    "./agents": "./src/agents/index.ts",
    "./cli": "./src/cli/index.ts",
    "./config": "./src/config/index.ts",
    "./config/define": "./src/config/define.ts",
    "./constants": "./src/constants/index.ts",
    "./session": "./src/session/index.ts",
    "./storage": "./src/storage/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/x": "./src/utils/x.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agentic": "./bin/index.dev.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "pnpm exec agentic-x",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@clack/prompts": "catalog:cli",
    "@hairy/utils": "catalog:",
    "c12": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "hookable": "catalog:",
    "pathe": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:",
    "agentic-x": "workspace:*",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:testing",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./agents": "./dist/agents/index.mjs",
      "./cli": "./dist/cli/index.mjs",
      "./config": "./dist/config/index.mjs",
      "./config/define": "./dist/config/define.mjs",
      "./constants": "./dist/constants/index.mjs",
      "./session": "./dist/session/index.mjs",
      "./storage": "./dist/storage/index.mjs",
      "./utils": "./dist/utils/index.mjs",
      "./utils/x": "./dist/utils/x.mjs",
      "./package.json": "./package.json"
    }
  }
}
